func break_object():
	var particleEffect = bricks_particle_scene.instantiate()
	particleEffect.get_node(\".\").set_emitting(true)
	particleEffect.position = self.get_position()  - Vector2(0, 20)
	get_tree().root.add_child(particleEffect)
	self.queue_free()
"

